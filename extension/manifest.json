{
  "manifest_version": 3,
  "name": "Debrief Glass (test)",
  "version": "1.1.2",
  "description": "Records a meeting tab (Meet, Zoom, Teams and more), transcribes Hindi, English and Malayalam, and writes the minutes.",
  "key": "",
  "minimum_chrome_version": "116",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "permissions": [
    "tabCapture",
    "offscreen",
    "storage",
    "unlimitedStorage",
    "activeTab",
    "sidePanel",
    "scripting",
    "notifications"
  ],
  "host_permissions": [
    "https://meet.google.com/*",
    "https://api.sarvam.ai/*",
    "https://api.deepgram.com/*",
    "https://api.anthropic.com/*",
    "https://generativelanguage.googleapis.com/*",
    "https://api.openai.com/*",
    "https://api.groq.com/*",
    "https://script.google.com/*",
    "https://script.googleusercontent.com/*"
  ],
  "optional_host_permissions": [
    "https://*/*",
    "http://localhost/*",
    "http://127.0.0.1/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "https://meet.google.com/*",
        "https://app.zoom.us/*",
        "https://*.zoom.us/wc/*",
        "https://zoom.us/wc/*",
        "https://teams.microsoft.com/*",
        "https://teams.live.com/*",
        "https://teams.cloud.microsoft/*",
        "https://*.webex.com/*",
        "https://whereby.com/*",
        "https://meet.jit.si/*",
        "https://8x8.vc/*",
        "https://app.goto.com/*",
        "https://app.gotomeeting.com/*",
        "https://app.bluejeans.com/*",
        "https://app.chime.aws/*",
        "https://meeting.zoho.com/*",
        "https://meeting.zoho.in/*",
        "https://meeting.zoho.eu/*",
        "https://web.skype.com/*"
      ],
      "js": [
        "dist/pill.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "background": {
    "service_worker": "dist/background.js"
  },
  "side_panel": {
    "default_path": "popup.html?side=1"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "Debrief",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png"
    }
  },
  "commands": {
    "toggle-recording": {
      "suggested_key": {
        "default": "Alt+Shift+M"
      },
      "description": "Start or stop recording the current tab"
    },
    "toggle-fullscreen": {
      "suggested_key": {
        "default": "Alt+Shift+F"
      },
      "description": "Make this browser window full screen, or bring it back"
    },
    "toggle-pause": {
      "suggested_key": {
        "default": "Alt+Shift+P"
      },
      "description": "Pause or resume the recording (nothing is transcribed while paused)"
    },
    "toggle-mic": {
      "suggested_key": {
        "default": "Alt+Shift+K"
      },
      "description": "Include or ignore my microphone while recording"
    }
  },
  "web_accessible_resources": [
    {
      "resources": [
        "popup.html"
      ],
      "matches": [
        "<all_urls>"
      ],
      "use_dynamic_url": true
    }
  ],
  "options_page": "options.html",
  "content_security_policy": {
    "extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self'; img-src 'self' data: blob:; media-src 'self' blob:"
  }
}
