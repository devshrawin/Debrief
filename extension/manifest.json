{
  "manifest_version": 3,
  "name": "Debrief – Meeting Minutes",
  "version": "0.1.0",
  "description": "Records a Google Meet tab, transcribes Hindi/English/Hinglish, and writes Minutes of Meeting.",
  "key": "",
  "minimum_chrome_version": "116",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "permissions": [
    "tabCapture",
    "offscreen",
    "storage",
    "unlimitedStorage",
    "activeTab",
    "scripting",
    "notifications"
  ],
  "host_permissions": [
    "https://meet.google.com/*",
    "https://api.sarvam.ai/*",
    "https://api.deepgram.com/*",
    "https://api.anthropic.com/*",
    "https://generativelanguage.googleapis.com/*",
    "https://api.openai.com/*",
    "https://api.groq.com/*"
  ],
  "optional_host_permissions": [
    "https://*/*",
    "http://localhost/*",
    "http://127.0.0.1/*"
  ],
  "content_scripts": [
    {
      "matches": ["https://meet.google.com/*"],
      "js": ["dist/pill.js"],
      "run_at": "document_idle"
    }
  ],
  "background": {
    "service_worker": "dist/background.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "Debrief",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png"
    }
  },
  "commands": {
    "toggle-recording": {
      "suggested_key": {
        "default": "Alt+Shift+M"
      },
      "description": "Start or stop recording the current tab"
    },
    "toggle-mic": {
      "suggested_key": {
        "default": "Alt+Shift+K"
      },
      "description": "Include or ignore my microphone while recording"
    }
  },
  "options_page": "options.html"
}
